# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=key

# YooKassa (ЮКасса) настройки
YOOKASSA_SHOP_ID=key
YOOKASSA_SECRET_KEY=key
YOOKASSA_PROVIDER_TOKEN=key

# Marzban API настройки
MARZBAN_API_URL=key
MARZBAN_USERNAME=key
MARZBAN_PASSWORD=key

# База данных
DATABASE_URL=sqlite:////var/lib/marzban/db.sqlite3

# Админы (через запятую, получить ID у @userinfobot)
ADMIN_IDS=123456789,987654321

# Настройки подписки
SUBSCRIPTION_PRICE=180  # в рублях
SUBSCRIPTION_DURATION=30  # в днях
